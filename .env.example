# Cloudflare Workers Environment Variables (.dev.vars or Cloudflare Dashboard)
# Copy this file to .dev.vars for local testing: cp .env.example .dev.vars

# Primary Workers AI generation model (Spec 02)
AI_MODEL=@cf/meta/llama-4-scout-17b-16e-instruct

# Fallback Workers AI model if primary is rate-limited or unavailable
AI_FALLBACK_MODEL=@cf/meta/llama-3.1-8b-instruct-fp8

# Maximum tokens per LLM inference call
AI_MAX_TOKENS=1024

# Number of grounded chunks to retrieve per search query
RETRIEVAL_TOP_K=5

# Rate Limiting: Maximum allowed requests per IP within the window
RATE_LIMIT_MAX=10

# Rate Limiting: Window duration in seconds
RATE_LIMIT_WINDOW_SECONDS=60

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=https://faq-mate.pages.dev,http://localhost:3000,http://localhost:8787,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:8787,http://127.0.0.1:5173

# Optional: Cloudflare Turnstile Bot Protection Secret Key
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
