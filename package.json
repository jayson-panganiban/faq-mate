{
  "name": "faq-mate",
  "version": "1.0.0",
  "description": "Australian General Insurance FAQ Edge RAG System on Cloudflare",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:frontend": "vite",
    "build": "vite build",
    "build:pages": "vite build",
    "preview": "vite preview",
    "deploy": "wrangler deploy",
    "ingest": "tsx scripts/normalize-corpus.ts && tsx scripts/compile-corpus.ts",
    "normalize": "tsx scripts/normalize-corpus.ts",
    "compile:corpus": "tsx scripts/compile-corpus.ts",
    "lint:corpus": "tsx scripts/compile-corpus.ts --lint-only",
    "upload:r2": "tsx scripts/upload-to-r2.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:evals": "vitest run tests/evals",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src scripts tests",
    "lint:fix": "biome check --write src scripts tests",
    "format": "biome format --write src scripts tests",
    "format:check": "biome format src scripts tests",
    "lint:py": "uvx ruff check scripts/collector && uvx ty check scripts/collector",
    "lint:py:fix": "uvx ruff check --fix scripts/collector",
    "format:py": "uvx ruff format scripts/collector",
    "format:py:check": "uvx ruff format --check scripts/collector",
    "typecheck:py": "uvx ty check scripts/collector",
    "verify": "npm run typecheck && npm run lint && npm run lint:corpus && npm test && npm run test:evals"
  },
  "keywords": [
    "cloudflare-workers",
    "workers-ai",
    "ai-search",
    "rag",
    "edge-computing",
    "insurance",
    "asic-compliance"
  ],
  "author": "Engineering Portfolio",
  "license": "Apache-2.0",
  "dependencies": {
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@cloudflare/vitest-pool-workers": "^0.7.4",
    "@cloudflare/workers-types": "^4.20250224.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "cheerio": "^1.2.0",
    "happy-dom": "^21.0.4",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3",
    "unpdf": "^0.12.1",
    "vite": "^5.4.21",
    "vitest": "^2.1.8"
  }
}
