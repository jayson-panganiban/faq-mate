{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "faq-mate-api",
  "main": "src/index.ts",
  "compatibility_date": "2024-11-01",
  "compatibility_flags": ["nodejs_compat"],
  
  // Workers AI Binding (Llama 3.3 70B & BGE Large Embeddings)
  "ai": {
    "binding": "AI"
  },

  // Cloudflare D1 Database (Chat Telemetry & Audit Trail)
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "faq-mate-telemetry",
      "database_id": "aab9d3c5-edc4-456e-8937-6f085193139b"
    }
  ],

  // Cloudflare R2 Bucket (Normalized Markdown & Source Documents)
  "r2_buckets": [
    {
      "binding": "CORPUS_BUCKET",
      "bucket_name": "faq-mate-corpus"
    }
  ],

  // Cloudflare KV Namespace (Prompt Templates & Feature Flags)
  "kv_namespaces": [
    {
      "binding": "CONFIG_KV",
      "id": "42970dfe6e5d4088b0427e3bcd2063d3"
    }
  ],

  // Cloudflare AI Search (Hybrid BM25 + Vector + Reranking)
  // Bound to faq-mate-corpus R2 bucket
  // Binding name: AI_SEARCH

  // Observability & Distributed Tracing
  "observability": {
    "enabled": true
  }
}
